# 데이터 수집과 주간 브리핑에 필요한 환경변수 목록입니다.
#
# 이 파일을 `.env`로 복사한 뒤 값을 채우세요. 실행할 때 자동으로 읽어
# 환경변수로 올립니다(src/tradingbot/env_file.py). 값이 빈 줄은 무시하므로
# 필요한 이름만 채우면 됩니다.
#
# 이미 설정된 환경변수는 덮어쓰지 않습니다. 잠깐 다른 값으로 시험하고 싶으면
# 터미널에서 그대로 넣으면 파일보다 우선합니다:
#     $env:KRX_ID = "..."
#
# 더블클릭 실행(.bat)은 새 프로세스라 위처럼 넣은 값을 보지 못합니다.
# 그래서 `.env` 파일이 있는 것이고, 터미널에서만 쓸 거라면 영구 등록도 됩니다:
#     [System.Environment]::SetEnvironmentVariable("KRX_ID", "...", "User")
#
# 값이 채워진 실제 .env 파일을 이 저장소에 만들더라도 .gitignore가
# `.env`와 `.env.*`를 커밋에서 막습니다 (이 템플릿만 예외).
# 그래도 config/*.toml 등 다른 파일에 자격증명을 직접 적지 마세요 —
# 그 경로는 .gitignore가 보호해주지 않습니다.

# 투자자 수급·밸류에이션(PER/PBR 등) 수집 — pykrx가 KRX 회원 로그인을 요구.
# 무료 가입: https://data.krx.co.kr
KRX_ID=
KRX_PW=

# 재무제표(DART) 수집 및 종목코드↔corp_code 매핑 — DART OpenAPI 키.
# 무료 발급: https://opendart.fss.or.kr
DART_API_KEY=

# 토스증권 오픈 API — WTS 설정 > Open API에서 발급.
# 발급 후 이 PC의 공인 IP를 반드시 허용 목록에 등록하세요.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# 계좌가 여러 개일 때만 필요합니다. 계좌 선택 안전 확인용입니다.
TOSS_ACCOUNT_NO=

# 텔레그램 봇 — @BotFather에서 봇 생성 후 토큰 발급, 봇과 대화 시작 후 chat id 확인.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
