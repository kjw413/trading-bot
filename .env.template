# 데이터 수집에 필요한 환경변수 목록입니다.
#
# 사용법: 이 파일을 저장소 루트에 `.env`로 복사하고 값을 채우면 됩니다.
#
#   copy .env.template .env
#
# CLI가 시작할 때 자동으로 읽습니다. 터미널마다 다시 등록할 필요가 없습니다.
#
# 이미 환경변수로 설정된 값이 항상 이깁니다. 한 번만 다르게 쓰고 싶으면
# 그 창에서 `$env:SEC_USER_AGENT = "..."` 로 덮어쓸 수 있습니다.
#
# `.env`와 `.env.*`는 .gitignore가 커밋을 막습니다 (이 템플릿만 예외).
# 그래도 config/*.toml 등 다른 파일에 자격증명을 적지 마세요 — 그 경로는
# .gitignore가 보호해주지 않습니다.
#
# 값이 비어 있는 줄은 무시되므로, 안 쓰는 항목은 그대로 두면 됩니다.

# 투자자 수급·밸류에이션(PER/PBR 등) 수집 — pykrx가 KRX 회원 로그인을 요구.
# 무료 가입: https://data.krx.co.kr
KRX_ID=
KRX_PW=

# 재무제표(DART) 수집 및 종목코드↔corp_code 매핑 — DART OpenAPI 키.
# 무료 발급: https://opendart.fss.or.kr
DART_API_KEY=

# 미국 실적 이벤트(SEC EDGAR 8-K Item 2.02) 수집 및 티커↔CIK 매핑.
# API 키는 없지만 SEC가 User-Agent에 연락처를 요구하며, 없으면 403으로 막습니다.
# 이름과 이메일을 적으세요 (예: "Hong Gildong hong@example.com").
# https://www.sec.gov/os/webmaster-faq#developers
SEC_USER_AGENT=
