# 수집 서버 crontab 예시.  crontab -e 로 붙여넣고 경로를 고친다.
#
# 호스트 시간대를 America/New_York으로 두는 것을 전제한다 (deploy/README.md §1).
# 그래야 아래 시각을 "장 마감 후"로 읽을 수 있다.

SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
HOME=/home/ubuntu
BOT=/home/ubuntu/trading-bot
LOGS=/home/ubuntu/trading-bot/state/cron

# 일일 수집 — 정규장 마감(16:00 ET) 후 한 시간.
# 그날 종가가 확정되고 실적 8-K가 대부분 접수된 뒤다. 조기폐장일에도
# exchange_calendars가 세션을 알고 있으므로 별도 처리는 필요 없다.
0 17 * * 1-5 cd $BOT && uv run python -m tradingbot --config config/us_equity.toml data pipeline --market US >> $LOGS/collect.log 2>&1

# 주간 갱신 — 후보 풀과 티커→CIK 매핑. 둘 다 7일/30일 TTL이라 이 주기면
# 캐시가 항상 신선하고, 신규 상장이 한 주 안에 반영된다.
30 18 * * 6 cd $BOT && uv run python -m tradingbot --config config/us_equity.toml data preflight >> $LOGS/weekly.log 2>&1

# 로그 정리 — 없으면 몇 달 뒤 디스크가 찬다.
0 3 * * 0 find $LOGS -name '*.log' -mtime +30 -delete
